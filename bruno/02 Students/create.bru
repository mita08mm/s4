meta {
  name: Create student
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/students
  body: json
  auth: none
}

body:json {
  {
    "code": "bru-{{runId}}",
    "first_name": "Bruno",
    "last_name": "Colección",
    "email": "bruno.{{runId}}@s4.edu"
  }
}

assert {
  res.status: eq 201
  res.body.code: eq BRU-{{runId}}
  res.headers.location: isString
}

script:post-response {
  bru.setVar("studentId", res.body.id);
}
