meta {
  name: Create class
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/classes
  body: json
  auth: none
}

body:json {
  {
    "code": "bru-c{{runId}}",
    "title": "Clase de la colección",
    "description": "Creada por Bruno"
  }
}

assert {
  res.status: eq 201
  res.body.code: eq BRU-C{{runId}}
}

script:post-response {
  bru.setVar("classId", res.body.id);
}
