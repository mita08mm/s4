meta {
  name: Create a class without description
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/classes
  body: json
  auth: none
}

body:json {
  {
    "code": "bru-d{{runId}}",
    "title": "Segunda clase de la colección"
  }
}

assert {
  res.status: eq 201
  res.body.description: isNull
}

script:post-response {
  bru.setVar("secondClassId", res.body.id);
}
