        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Code",
            "description": "Código único de la clase. Se guarda en mayúsculas.",
            "examples": [
              "MAT-101"
            ]
          },
          "title": {
            "type": "string",
